MODULE SceneSmoke;

IMPORT GameGeometry, GameSurface, GameRenderer, GameClock, GameBytes, GameMaterials, MathL;

PROCEDURE Do*;
VAR world: GameGeometry.World;
	wall, hit: GameGeometry.Wall;
	frame: GameSurface.Frame;
	clock: GameClock.Clock;
	x, y, distance: FLOAT64;
	i, total: SIGNED32;
	bytes: ARRAY 4 OF CHAR;
	texture: GameMaterials.Texture;
BEGIN
	bytes[0] := 0FFX;
	bytes[1] := 0FFX;
	bytes[2] := 0FFX;
	bytes[3] := 07FX;
	ASSERT(GameBytes.U16(bytes, 0) = 65535);
	ASSERT(GameBytes.I16(bytes, 0) = -1);
	ASSERT(GameBytes.I32(bytes, 0) = MAX(SIGNED32));
	bytes[3] := 080X;
	bytes[0] := 0X;
	bytes[1] := 0X;
	bytes[2] := 0X;
	ASSERT(GameBytes.I32(bytes, 0) = MIN(SIGNED32));
	ASSERT(GameBytes.Range(bytes, 4, 0));
	ASSERT(~GameBytes.Range(bytes, -1, 1));
	ASSERT(~GameBytes.Range(bytes, 1, MAX(SIGNED32)));
	ASSERT(~GameBytes.Range(bytes, MAX(SIGNED32), 1));
	NEW(texture, 2, 2);
	texture.Set(0, 0, 0FF0000H);
	texture.Set(1, 0, 000FF00H);
	texture.Set(0, 1, 00000FFH);
	texture.Set(1, 1, 0FFFFFFH);
	texture.Seal;
	ASSERT(texture.Sample(0.1, 0.1) = 0FF0000H);
	ASSERT(texture.Sample(0.6, 0.1) = 000FF00H);
	ASSERT(texture.Sample(-0.1, -0.1) = 0FFFFFFH);
	ASSERT(texture.Sample(1.1, 2.1) = 0FF0000H);
	NEW(world, 2);
	wall.ax := 2;
	wall.ay := -2;
	wall.bx := 2;
	wall.by := 2;
	wall.bottom := 0;
	wall.top := 2;
	wall.color := 0FF8040H;
	wall.light := 255;
	wall.texture := texture;
	wall.uScale := 1;
	wall.vScale := 1;
	wall.uOffset := 0;
	wall.vOffset := 0;
	ASSERT(world.Add(wall));
	wall.bx := wall.ax;
	wall.by := wall.ay;
	ASSERT(~world.Add(wall));
	NEW(texture, 1, 1);
	wall.bx := 3;
	wall.texture := texture;
	ASSERT(~world.Add(wall));
	world.Seal;
	ASSERT(~world.Add(wall));
	ASSERT(world.Count() = 1);
	ASSERT(world.Cast(0, 0, 1, 0, distance, hit));
	ASSERT(ABS(distance - 2) < 0.000001);
	ASSERT(hit.color = 0FF8040H);
	ASSERT(~world.Cast(0, 0, -1, 0, distance, hit));
	ASSERT(~world.Cast(0, 0, 0, 1, distance, hit));
	ASSERT(world.Cast(0, -2, 1, 0, distance, hit));
	ASSERT(world.Free(0, 0, 0.25));
	ASSERT(~world.Free(2, 0, 0.25));
	ASSERT(~world.Free(2, 2.1, 0.25));
	ASSERT(world.Free(2, 2.3, 0.25));
	x := 0;
	y := 0;
	ASSERT(world.Move(x, y, 8, 1, 0.25));
	ASSERT((x < 1.75) & (x > 1.6));
	ASSERT(ABS(y - 1) < 0.000001);
	ASSERT(~world.Move(x, y, 1000, 0, 0.25));
	NEW(frame, 32, 20);
	GameRenderer.Render(world, frame, 0, 0, 0, 1);
	ASSERT(frame.Pixel(16, 10) # 0202938H);
	ASSERT(frame.Pixel(16, 10) # 035302CH);
	ASSERT(frame.Pixel(16, 10) = 0DB0000H);
	ASSERT(frame.Pixel(24, 10) = 000DB00H);
	GameRenderer.Render(world, frame, 0, 0, MathL.pi, 1);
	ASSERT(frame.Pixel(16, 0) = 0202938H);
	ASSERT(frame.Pixel(16, 19) = 035302CH);
	frame.Span(0, -3, 1, 0123456H);
	ASSERT(frame.Pixel(0, 0) = 0123456H);
	ASSERT(frame.Pixel(0, 1) = 0123456H);
	ASSERT(frame.Pixel(0, 2) = 0202938H);
	frame.Span(0, 19, 99, 0654321H);
	ASSERT(frame.Pixel(0, 19) = 0654321H);
	frame.Span(1, 0, 0, 0FFFFFFH);
	ASSERT(frame.Pixel(1, 0) = 0FFFFFFH);
	NEW(clock, 35);
	total := 0;
	FOR i := 1 TO 1000 DO
		INC(total, clock.Consume(1))
	END;
	ASSERT(total = 35);
	ASSERT(clock.Consume(0) = 0);
	ASSERT(clock.Consume(1000) = 35)
END Do;

END SceneSmoke.

MODULE SpriteSmoke;

IMPORT GameRenderer, GameGeometry, GameMaterials, GameSurface;

PROCEDURE Do*;
VAR world: GameGeometry.World;
	wall: GameGeometry.Wall;
	sprite: GameRenderer.Sprite;
	texture, blue: GameMaterials.Texture;
	frame: GameSurface.Frame;
	background, red: SIGNED32;
BEGIN
	NEW(frame, 32, 20);
	frame.Background(0202938H, 035302CH);
	frame.DepthSpan(0, -2, 1, 0FF0000H, 2);
	frame.DepthSpan(0, 0, 1, 00000FFH, 3);
	ASSERT(frame.Pixel(0, 0) = 0FF0000H);
	frame.DepthSpan(0, 0, 1, 0, 1);
	ASSERT(frame.Pixel(0, 0) = 0);
	frame.Background(0202938H, 035302CH);
	frame.DepthSpan(0, 0, 1, 00000FFH, 3);
	ASSERT(frame.Pixel(0, 0) = 00000FFH);
	frame.Occlude(1, 0, 1, 2);
	frame.DepthSpan(1, 0, 1, 0FF0000H, 3);
	ASSERT(frame.Pixel(1, 0) = 0202938H);
	NEW(world, 1);
	wall.ax := 4;
	wall.ay := -4;
	wall.bx := 4;
	wall.by := 4;
	wall.top := 2;
	wall.color := 0C08040H;
	wall.light := 255;
	ASSERT(world.Add(wall));
	world.Seal;
	NEW(texture, 2, 2);
	texture.Set(0, 0, 0);
	texture.Set(1, 0, 0FF0000H);
	texture.Set(0, 1, 000FF00H);
	texture.Seal;
	sprite.texture := texture;
	sprite.texelsPerUnit := 1;
	sprite.left := 1;
	sprite.top := 2;
	sprite.light := 255;
	sprite.x := 2;
	GameRenderer.Render(world, frame, 0, 0, 0, 1);
	background := frame.Pixel(24, 15);
	GameRenderer.DrawSprite(sprite, frame, 0, 0, 0, 1);
	ASSERT(frame.Pixel(8, 0) = 0);
	red := frame.Pixel(24, 0);
	ASSERT(red = 0DB0000H);
	ASSERT(frame.Pixel(24, 15) = background);
	GameRenderer.Render(world, frame, 0, 0, 0, 1);
	sprite.flipped := TRUE;
	GameRenderer.DrawSprite(sprite, frame, 0, 0, 0, 1);
	ASSERT(frame.Pixel(8, 0) = red);
	ASSERT(frame.Pixel(24, 0) = 0);
	sprite.flipped := FALSE;
	sprite.fullbright := TRUE;
	GameRenderer.Render(world, frame, 0, 0, 0, 1);
	GameRenderer.DrawSprite(sprite, frame, 0, 0, 0, 1);
	ASSERT(frame.Pixel(24, 0) = 0FF0000H);
	NEW(blue, 1, 1);
	blue.Set(0, 0, 00000FFH);
	blue.Seal;
	sprite.texture := blue;
	sprite.x := 3;
	sprite.texelsPerUnit := 0.5;
	sprite.left := 0;
	sprite.top := 1;
	GameRenderer.DrawSprite(sprite, frame, 0, 0, 0, 1);
	ASSERT(frame.Pixel(24, 7) = 0FF0000H);
	ASSERT(frame.Pixel(24, 15) = 00000FFH);
	sprite.x := 6;
	GameRenderer.Render(world, frame, 0, 0, 0, 1);
	background := frame.Pixel(16, 10);
	GameRenderer.DrawSprite(sprite, frame, 0, 0, 0, 1);
	ASSERT(frame.Pixel(16, 10) = background);
	sprite.x := -2;
	GameRenderer.DrawSprite(sprite, frame, 0, 0, 0, 1);
	ASSERT(frame.Pixel(16, 10) = background)
END Do;

END SpriteSmoke.

MODULE SectorSmoke;

IMPORT GameGeometry, GameSurface, GameRenderer, GameMaterials, MathL;

PROCEDURE Wall(world: GameGeometry.World; sector, neighbor: SIGNED32; ax, ay, bx, by: FLOAT64);
VAR wall: GameGeometry.Wall;
BEGIN
	wall.ax := ax;
	wall.ay := ay;
	wall.bx := bx;
	wall.by := by;
	wall.bottom := 0;
	wall.top := 2;
	wall.color := 0D08040H;
	wall.light := 255;
	wall.texture := NIL;
	wall.upper := NIL;
	wall.lower := NIL;
	wall.sector := sector;
	wall.neighbor := neighbor;
	wall.blocking := FALSE;
	wall.omitMiddle := FALSE;
	wall.omitUpper := FALSE;
	wall.omitLower := FALSE;
	wall.upperAnchor := 2;
	wall.lowerAnchor := 0;
	wall.xOffset := 0;
	wall.yOffset := 0;
	ASSERT(world.Add(wall))
END Wall;

PROCEDURE RoomWalls(world: GameGeometry.World);
BEGIN
	Wall(world, 0, -1, -4, -2, 0, -2);
	Wall(world, 0, -1, 0, 2, -4, 2);
	Wall(world, 0, -1, -4, 2, -4, -2);
	Wall(world, 1, -1, 0, -2, 4, -2);
	Wall(world, 1, -1, 4, -2, 4, 2);
	Wall(world, 1, -1, 4, 2, 0, 2);
	Wall(world, 0, 1, 0, -2, 0, 2);
	Wall(world, 1, 0, 0, 2, 0, -2)
END RoomWalls;

PROCEDURE Partition;
VAR world: GameGeometry.World;
	regions: ARRAY 2 OF GameGeometry.Sector;
	nodes: ARRAY 1 OF GameGeometry.Partition;
	leaves: ARRAY 2 OF SIGNED32;
	direction: SIGNED32;
BEGIN
	FOR direction := 0 TO 2 DO
		NEW(world, 8);
		regions[0].ceiling := 2;
		regions[1] := regions[0];
		leaves[0] := 0;
		leaves[1] := 1;
		nodes[0].x := 0;
		nodes[0].dx := 0;
		nodes[0].dy := -4;
		nodes[0].front := -2;
		nodes[0].back := -1;
		ASSERT(~world.SetPartition(nodes, leaves));
		ASSERT(world.SetSectors(regions));
		leaves[1] := 2;
		ASSERT(~world.SetPartition(nodes, leaves));
		leaves[1] := 1;
		nodes[0].front := 0;
		ASSERT(~world.SetPartition(nodes, leaves));
		nodes[0].front := -3;
		ASSERT(~world.SetPartition(nodes, leaves));
		nodes[0].front := MIN(SIGNED32);
		ASSERT(~world.SetPartition(nodes, leaves));
		nodes[0].front := -2;
		nodes[0].dy := 0;
		ASSERT(~world.SetPartition(nodes, leaves));
		nodes[0].dy := -4;
		nodes[0].x := 1000001;
		ASSERT(~world.SetPartition(nodes, leaves));
		nodes[0].x := 0;
		IF direction > 0 THEN
			nodes[0].dx := 4
		END;
		IF direction = 1 THEN
			nodes[0].dy := 0
		END;
		ASSERT(world.SetPartition(nodes, leaves));
		ASSERT(~world.SetPartition(nodes, leaves));
		nodes[0].front := -1;
		leaves[1] := 0;
		RoomWalls(world);
		world.Seal;
		ASSERT(~world.SetPartition(nodes, leaves));
		ASSERT(world.Locate(0, 0) = direction MOD 2);
		ASSERT(world.Locate(20, 0) = -1);
		IF direction = 0 THEN
			ASSERT(world.Locate(2, 0) = 1);
			ASSERT(world.Locate(-2, 0) = 0)
		ELSE
			ASSERT(world.Locate(2, 1) = 1);
			ASSERT(world.Locate(-2, -1) = 0)
		END
	END
END Partition;

PROCEDURE MaskedMaterial;
VAR world: GameGeometry.World;
	regions: ARRAY 2 OF GameGeometry.Sector;
	wall: GameGeometry.Wall;
	texture: GameMaterials.Texture;
BEGIN
	NEW(world, 1);
	regions[0].ceiling := 2;
	regions[1] := regions[0];
	ASSERT(world.SetSectors(regions));
	wall.ax := 0;
	wall.ay := -2;
	wall.bx := 0;
	wall.by := 2;
	wall.top := 2;
	wall.neighbor := 1;
	wall.uScale := 1;
	wall.vScale := 1;
	wall.texelsPerUnit := 1;
	NEW(texture, 2, 2);
	wall.texture := texture;
	ASSERT(~world.Add(wall));
	texture.Set(0, 0, 0);
	texture.Seal;
	wall.texelsPerUnit := 0;
	ASSERT(~world.Add(wall));
	wall.texelsPerUnit := 1025;
	ASSERT(~world.Add(wall));
	wall.texelsPerUnit := 1;
	ASSERT(world.Add(wall))
END MaskedMaterial;

PROCEDURE Heights;
VAR world, closed, reopened: GameGeometry.World;
	regions: ARRAY 2 OF GameGeometry.Sector;
	heights: ARRAY 2 OF FLOAT64;
	short: ARRAY 1 OF FLOAT64;
	region: GameGeometry.Sector;
	frame: GameSurface.Frame;
	floor: FLOAT64;
	pixel: SIGNED32;
BEGIN
	NEW(world, 8);
	heights[0] := 2;
	heights[1] := 0;
	ASSERT(world.WithCeilings(heights) = NIL);
	regions[0].ceiling := 2;
	regions[1] := regions[0];
	ASSERT(world.SetSectors(regions));
	RoomWalls(world);
	ASSERT(world.WithCeilings(heights) = NIL);
	world.Seal;
	ASSERT(world.WithCeilings(short) = NIL);
	heights[1] := 1000001;
	ASSERT(world.WithCeilings(heights) = NIL);
	heights[1] := 0;
	closed := world.WithCeilings(heights);
	ASSERT(closed # NIL);
	heights[1] := 2;
	region := closed.Region(1);
	ASSERT(region.ceiling = 0);
	ASSERT(~closed.Stand(0, 0, 0.25, 0, 1, 0, floor));
	ASSERT(world.Stand(0, 0, 0.25, 0, 1, 0, floor));
	NEW(frame, 32, 20);
	GameRenderer.Render(world, frame, -2, 0, 0, 0.64);
	pixel := frame.Pixel(16, 10);
	GameRenderer.Render(closed, frame, -2, 0, 0, 0.64);
	ASSERT(frame.Pixel(16, 10) # pixel);
	reopened := closed.WithCeilings(heights);
	ASSERT(reopened # NIL);
	ASSERT(reopened.Stand(0, 0, 0.25, 0, 1, 0, floor));
	ASSERT(reopened.Count() = world.Count());
	ASSERT(reopened.Locate(2, 0) = 1);
	GameRenderer.Render(world, frame, -2, 0, 0, 0.64);
	ASSERT(frame.Pixel(16, 10) = pixel);
	region := closed.Region(1);
	ASSERT(region.ceiling = 0);
	region := world.Region(1);
	ASSERT(region.ceiling = 2)
END Heights;

PROCEDURE Sky;
VAR world: GameGeometry.World;
	regions: ARRAY 2 OF GameGeometry.Sector;
	texture: GameMaterials.Texture;
	frame: GameSurface.Frame;
	x, y, feet: FLOAT64;
BEGIN
	NEW(world, 8);
	NEW(texture, 2, 2);
	texture.Set(0, 0, 0102030H);
	texture.Set(1, 0, 0A0B0C0H);
	texture.Set(0, 1, 0203040H);
	texture.Set(1, 1, 0B0C0D0H);
	regions[0].floor := 0;
	regions[0].ceiling := 2;
	regions[0].light := 0;
	regions[0].skyTexture := texture;
	regions[0].skyUScale := 1;
	regions[0].skyVScale := 1;
	regions[0].skyVOffset := 0.5;
	regions[1] := regions[0];
	regions[1].ceiling := 1;
	ASSERT(~world.SetSectors(regions));
	texture.Seal;
	regions[0].skyUScale := 0;
	ASSERT(~world.SetSectors(regions));
	regions[0].skyUScale := 1;
	regions[0].skyVScale := -1;
	ASSERT(~world.SetSectors(regions));
	regions[0].skyVScale := 1;
	regions[0].skyVOffset := 1000001;
	ASSERT(~world.SetSectors(regions));
	regions[0].skyVOffset := 0.5;
	ASSERT(world.SetSectors(regions));
	RoomWalls(world);
	world.Seal;
	NEW(frame, 32, 20);
	GameRenderer.Render(world, frame, -2, 0, 0, 0.64);
	ASSERT(frame.Pixel(16, 0) = 0A0B0C0H);
	ASSERT(frame.Pixel(16, 6) = 0A0B0C0H);
	GameRenderer.Render(world, frame, -1, 0, 0, 0.8);
	ASSERT(frame.Pixel(16, 0) = 0A0B0C0H);
	GameRenderer.Render(world, frame, 2, 0, -MathL.pi / 2, 0.64);
	ASSERT(frame.Pixel(16, 0) = 0102030H);
	x := -2;
	y := 0;
	feet := 0;
	ASSERT(world.MovePlayer(x, y, feet, 4, 0, 0.25, 1.1, 0.375));
	ASSERT(x < -0.25)
END Sky;

PROCEDURE FreePosition(x, y, radius: FLOAT64): BOOLEAN;
BEGIN
	RETURN (ABS(x) >= radius + 0.25) OR (ABS(y) >= radius + 0.25)
END FreePosition;

PROCEDURE Occupancy;
VAR world: GameGeometry.World;
	regions: ARRAY 2 OF GameGeometry.Sector;
	x, y, feet: FLOAT64;
BEGIN
	NEW(world, 8);
	regions[0].ceiling := 2;
	regions[1] := regions[0];
	regions[1].floor := 0.25;
	ASSERT(world.SetSectors(regions));
	RoomWalls(world);
	world.Seal;
	x := -2;
	y := 0;
	feet := 0;
	ASSERT(world.MovePlayerChecked(x, y, feet, 4, 0, 0.25, 0.875, 0.375, FreePosition));
	ASSERT((x <= -0.5) & (x > -0.625) & (y = 0) & (feet = 0));
	ASSERT(FreePosition(x, y, 0.25));
	ASSERT(world.MovePlayerChecked(x, y, feet, 2, 1, 0.25, 0.875, 0.375, FreePosition));
	ASSERT((x > 0.25) & (y > 0.9) & (feet = 0.25));
	ASSERT(FreePosition(x, y, 0.25));
	x := -2;
	y := 0.5;
	feet := 0;
	ASSERT(world.MovePlayerChecked(x, y, feet, 4, 0, 0.25, 0.875, 0.375, FreePosition));
	ASSERT((ABS(x - 2) < 0.000001) & (y = 0.5) & (feet = 0.25));
	ASSERT(~world.MovePlayerChecked(x, y, feet, 1000, 0, 0.25, 0.875, 0.375, FreePosition));
	ASSERT((ABS(x - 2) < 0.000001) & (y = 0.5) & (feet = 0.25));
	x := -2;
	y := 0;
	feet := 0;
	ASSERT(world.MovePlayerChecked(x, y, feet, 4, 0, 0.25, 0.875, 0.375, NIL));
	ASSERT((ABS(x - 2) < 0.000001) & (feet = 0.25))
END Occupancy;

PROCEDURE {TEST} RayPlanesAndPortals*;
VAR world, closed: GameGeometry.World;
	regions: ARRAY 2 OF GameGeometry.Sector;
	heights: ARRAY 2 OF FLOAT64;
BEGIN
	NEW(world, 8);
	regions[0].ceiling := 2;
	regions[1] := regions[0];
	ASSERT(world.SetSectors(regions));
	RoomWalls(world);
	world.Seal;
	ASSERT(world.TraceRay(-2, 0, 1, 0, 0.5, 0, 8) = 6);
	ASSERT(world.TraceRay(-2, 0, 1, 0, 0.5, 0, 1) = 1);
	ASSERT(world.TraceRay(-2, 0, 1, 0, 0.5, -1, 8) = 0.5);
	ASSERT(world.TraceRay(-2, 0, 1, 0, 0.5, 1, 8) = 1.5);
	heights[0] := 2;
	heights[1] := 1;
	closed := world.WithCeilings(heights);
	ASSERT(ABS(closed.TraceRay(-2, 0, 1, 0, 0.5, 0.1, 8) - 5) < 0.000001);
	ASSERT(closed.TraceRay(-2, 0, 1, 0, 1.5, 0, 8) = 2);
	heights[1] := 0;
	closed := world.WithCeilings(heights);
	ASSERT(closed.TraceRay(-2, 0, 1, 0, 0.5, 0, 8) = 2);
	ASSERT(closed.TraceRay(0, 0, 1, 0, 0.5, 0, 8) = 0);
	ASSERT(closed.TraceRay(0, 0, -1, 0, 0.5, 0, 8) = 4);
	ASSERT(world.TraceRay(-2, 0, 1, 0, 0.5, 0, 8) = 6);
	ASSERT(world.TraceRay(-2, 0, 1, 0, 0, 0, 8) = 0);
	ASSERT(world.TraceRay(-2, 0, 1, 0, 2, 0, 8) = 0);
	ASSERT(world.TraceRay(20, 0, 1, 0, 0.5, 0, 8) = 0);
	ASSERT(world.TraceRay(-2, 0, 1, 0, 0.5, 0, -1) = 0);
	ASSERT(world.TraceRay(-2, 0, MAX(FLOAT64), 0, 0.5, 0, 8) = 0)
END RayPlanesAndPortals;

PROCEDURE {TEST} MovingFloors*;
VAR world, lowered, closed, reopened: GameGeometry.World;
	regions: ARRAY 2 OF GameGeometry.Sector;
	floors, ceilings: ARRAY 2 OF FLOAT64;
	short: ARRAY 1 OF FLOAT64;
	frame: GameSurface.Frame;
	floor, x, y, feet: FLOAT64;
	pixel: SIGNED32;
BEGIN
	NEW(world, 8);
	ASSERT(world.WithFloors(floors) = NIL);
	regions[0].ceiling := 3;
	regions[1] := regions[0];
	regions[1].floor := 1;
	ASSERT(world.SetSectors(regions));
	RoomWalls(world);
	ASSERT(world.WithFloors(floors) = NIL);
	world.Seal;
	ASSERT(world.WithFloors(short) = NIL);
	floors[1] := 1000001;
	ASSERT(world.WithFloors(floors) = NIL);
	floors[1] := MAX(FLOAT64);
	ASSERT(world.WithFloors(floors) = NIL);
	floors[1] := 0.25;
	lowered := world.WithFloors(floors);
	ASSERT(lowered # NIL);
	floors[1] := 2;
	ASSERT(lowered.Region(1).floor = 0.25);
	ASSERT(world.Region(1).floor = 1);
	ASSERT(~world.Stand(0, 0, 0.25, 0, 1, 0.375, floor));
	ASSERT(lowered.Stand(0, 0, 0.25, 0, 1, 0.375, floor));
	ASSERT(floor = 0.25);
	ASSERT(world.TraceRay(-2, 0, 1, 0, 0.5, 0, 8) = 2);
	ASSERT(lowered.TraceRay(-2, 0, 1, 0, 0.5, 0, 8) = 6);
	ASSERT(lowered.TraceRay(-2, 0, 1, 0, 0.5, -1, 8) = 0.5);
	NEW(frame, 32, 20);
	GameRenderer.Render(world, frame, -2, 0, 0, 0.64);
	pixel := frame.Pixel(16, 10);
	GameRenderer.Render(lowered, frame, -2, 0, 0, 0.64);
	ASSERT(frame.Pixel(16, 10) # pixel);
	ceilings[0] := 3;
	ceilings[1] := 0;
	closed := lowered.WithCeilings(ceilings);
	ASSERT((closed.Region(1).floor = 0.25) & (closed.Region(1).ceiling = 0));
	floors[1] := 0.5;
	closed := closed.WithFloors(floors);
	ASSERT((closed.Region(1).floor = 0.5) & (closed.Region(1).ceiling = 0));
	ASSERT(lowered.Region(1).floor = 0.25);
	ceilings[1] := 3;
	reopened := closed.WithCeilings(ceilings);
	ASSERT((reopened.Region(1).floor = 0.5) & (reopened.Region(1).ceiling = 3));
	x := -0.5;
	y := 0;
	feet := 0;
	ASSERT(lowered.MovePlayer(x, y, feet, 1, 0, 0.25, 1, 0.375));
	ASSERT((x > 0) & (feet = 0.25));
	ASSERT(lowered.TouchesSector(1, 2, 0, 0.25));
	ASSERT(lowered.TouchesSector(1, -0.1, 0, 0.25));
	ASSERT(~lowered.TouchesSector(1, -0.25, 0, 0.25));
	ASSERT(~lowered.TouchesSector(1, -0.5, 0, 0.25));
	ASSERT(~lowered.TouchesSector(1, MAX(FLOAT64), 0, 0.25));
	ASSERT(~lowered.TouchesSector(1, 2, 0, 0))
END MovingFloors;

PROCEDURE {TEST} MovingFloorAnchors*;
VAR world, moved: GameGeometry.World;
	regions: ARRAY 2 OF GameGeometry.Sector;
	floors, ceilings: ARRAY 2 OF FLOAT64;
	wall, hit: GameGeometry.Wall;
	distance: FLOAT64;
BEGIN
	NEW(world, 2);
	regions[0].ceiling := 2;
	regions[1] := regions[0];
	ASSERT(world.SetSectors(regions));
	wall.ax := -4;
	wall.ay := -2;
	wall.bx := -4;
	wall.by := 2;
	wall.neighbor := -1;
	wall.top := 2;
	wall.vScale := 1;
	wall.vOffset := 3;
	wall.middleFromFloor := TRUE;
	ASSERT(world.Add(wall));
	wall.ax := 0;
	wall.bx := 0;
	wall.neighbor := 1;
	wall.lowerAnchor := 4;
	wall.middleFromFloor := FALSE;
	ASSERT(world.Add(wall));
	world.Seal;
	floors[0] := 0.5;
	floors[1] := 0.75;
	ceilings[0] := 1.75;
	ceilings[1] := 2;
	moved := world.WithFloors(floors);
	moved := moved.WithCeilings(ceilings);
	ASSERT(moved.Cast(-2, 0, -1, 0, distance, hit));
	ASSERT((hit.bottom = 0.5) & (hit.top = 1.75) & (hit.vOffset = 3.75));
	ASSERT(moved.Cast(-2, 0, 1, 0, distance, hit));
	ASSERT(hit.lowerAnchor = 4.75);
	ASSERT(world.Cast(-2, 0, -1, 0, distance, hit));
	ASSERT((hit.bottom = 0) & (hit.top = 2) & (hit.vOffset = 3))
END MovingFloorAnchors;

PROCEDURE {TEST} WallTextures*;
VAR world, moved, changed: GameGeometry.World;
	regions: ARRAY 2 OF GameGeometry.Sector;
	floors, ceilings: ARRAY 2 OF FLOAT64;
	wall, hit: GameGeometry.Wall;
	first, second: GameMaterials.Texture;
	distance: FLOAT64;
BEGIN
	NEW(world, 2);
	NEW(first, 64, 64);
	NEW(second, 32, 48);
	first.Set(0, 0, 0FF0000H);
	first.Seal;
	ASSERT(world.WithWallTexture(0, GameGeometry.MiddleTexture, first) = NIL);
	regions[0].ceiling := 3;
	regions[1].floor := 1;
	regions[1].ceiling := 2;
	ASSERT(world.SetSectors(regions));
	wall.ay := -2;
	wall.by := 2;
	wall.top := 3;
	wall.neighbor := -1;
	wall.texture := first;
	wall.uScale := 1;
	wall.vScale := 1;
	wall.xOffset := 0.25;
	wall.yOffset := -0.25;
	wall.uOffset := 0.25;
	wall.vOffset := -3.25;
	wall.middleFromFloor := TRUE;
	wall.texelsPerUnit := 64;
	ASSERT(world.Add(wall));
	wall.ax := 2;
	wall.bx := 2;
	wall.neighbor := 1;
	wall.upper := first;
	wall.lower := first;
	wall.upperFromNeighbor := TRUE;
	wall.upperAnchor := 3;
	wall.lowerAnchor := 1;
	ASSERT(world.Add(wall));
	ASSERT(world.WithWallTexture(0, GameGeometry.MiddleTexture, first) = NIL);
	world.Seal;
	ASSERT(world.WithWallTexture(-1, GameGeometry.MiddleTexture, first) = NIL);
	ASSERT(world.WithWallTexture(2, GameGeometry.MiddleTexture, first) = NIL);
	ASSERT(world.WithWallTexture(0, -1, first) = NIL);
	ASSERT(world.WithWallTexture(0, 3, first) = NIL);
	ASSERT(world.WithWallTexture(0, GameGeometry.MiddleTexture, NIL) = NIL);
	ASSERT(world.WithWallTexture(0, GameGeometry.MiddleTexture, second) = NIL);
	second.Set(0, 0, 00000FFH);
	second.Seal;
	floors[0] := 0.5;
	floors[1] := 1.25;
	ceilings[0] := 4;
	ceilings[1] := 2.5;
	moved := world.WithFloors(floors);
	moved := moved.WithCeilings(ceilings);
	changed := moved.WithWallTexture(0, GameGeometry.MiddleTexture, second);
	ASSERT(changed # NIL);
	ASSERT((changed.Region(0).floor = 0.5) & (changed.Region(0).ceiling = 4));
	ASSERT(changed.CastSector(0, -1, 0, 1, 0, 0, distance, hit));
	ASSERT(hit.texture = second);
	ASSERT((hit.uScale = 2) & (ABS(hit.vScale - 4.0 / 3) < 0.000001));
	ASSERT((hit.uOffset = 0.5) & (ABS(hit.vOffset + 5) < 0.000001));
	ASSERT(moved.CastSector(0, -1, 0, 1, 0, 0, distance, hit));
	ASSERT(hit.texture = first);
	changed := changed.WithWallTexture(1, GameGeometry.UpperTexture, second);
	changed := changed.WithWallTexture(1, GameGeometry.LowerTexture, second);
	ASSERT(changed.CastSector(0, 1, 0, 1, 0, 0, distance, hit));
	ASSERT((hit.upper = second) & (hit.lower = second));
	ASSERT((hit.upperAnchor = 3.25) & (hit.lowerAnchor = 1.25));
	changed := changed.WithFloors(floors);
	changed := changed.WithCeilings(ceilings);
	ASSERT(changed.CastSector(0, 1, 0, 1, 0, 0, distance, hit));
	ASSERT(hit.upper = second);
	ASSERT(world.CastSector(0, 1, 0, 1, 0, 0, distance, hit));
	ASSERT((hit.upper = first) & (hit.lower = first));
	ASSERT((world.Region(0).floor = 0) & (world.Region(0).ceiling = 3))
END WallTextures;

PROCEDURE Do*;
VAR world: GameGeometry.World;
	regions: ARRAY 2 OF GameGeometry.Sector;
	region: GameGeometry.Sector;
	wall: GameGeometry.Wall;
	texture: GameMaterials.Texture;
	frame: GameSurface.Frame;
	x, y, feet, floor, distance: FLOAT64;
BEGIN
	WallTextures;
	MovingFloors;
	MovingFloorAnchors;
	RayPlanesAndPortals;
	Partition;
	MaskedMaterial;
	Heights;
	Sky;
	Occupancy;
	NEW(world, 8);
	regions[0].floor := 0;
	regions[0].ceiling := 2;
	regions[0].light := 255;
	regions[1] := regions[0];
	regions[1].floor := 0.25;
	regions[1].ceiling := 1.75;
	regions[1].light := -1;
	ASSERT(~world.SetSectors(regions));
	regions[1].light := 255;
	NEW(texture, 1, 1);
	regions[1].floorTexture := texture;
	ASSERT(~world.SetSectors(regions));
	texture.Set(0, 0, 000FF00H);
	texture.Seal;
	ASSERT(world.SetSectors(regions));
	ASSERT(~world.SetSectors(regions));
	regions[0].floor := -10;
	RoomWalls(world);
	world.Seal;
	ASSERT(~world.SetSectors(regions));
	ASSERT(world.SectorCount() = 2);
	region := world.Region(0);
	ASSERT(region.floor = 0);
	ASSERT(world.Locate(-2, 0) = 0);
	ASSERT(world.Locate(2, 0) = 1);
	ASSERT(world.Locate(5, 0) = -1);
	ASSERT(~world.Stand(-4, 0, 0.25, 0, 0.875, 0.375, floor));
	ASSERT(world.Stand(-3.75, 0, 0.25, 0, 0.875, 0.375, floor));
	ASSERT(~world.Stand(-3.750001, 0, 0.25, 0, 0.875, 0.375, floor));
	ASSERT(~world.Stand(0, 0, 0.25, 0, 0.875, 0.2, floor));
	ASSERT(~world.Stand(0, 0, 0.25, 0, 1.8, 0.375, floor));
	ASSERT(world.Stand(0, 0, 0.25, 0, 0.875, 0.375, floor));
	ASSERT(floor = 0.25);
	x := -2;
	y := 0;
	feet := 0;
	ASSERT(world.MovePlayer(x, y, feet, 4, 0, 0.25, 0.875, 0.375));
	ASSERT(ABS(x - 2) < 0.000001);
	ASSERT(feet = 0.25);
	ASSERT(world.MovePlayer(x, y, feet, -4, 0, 0.25, 0.875, 0.375));
	ASSERT(ABS(x + 2) < 0.000001);
	ASSERT(feet = 0);
	ASSERT(~world.MovePlayer(x, y, feet, 1000, 0, 0.25, 0.875, 0.375));
	ASSERT(world.CastSector(0, -2, 0, 1, 0, 0, distance, wall));
	ASSERT((distance = 2) & (wall.neighbor = 1));
	ASSERT(world.CastSector(1, -2, 0, 1, 0, 2, distance, wall));
	ASSERT((distance = 6) & (wall.neighbor = -1));
	NEW(frame, 32, 20);
	GameRenderer.Render(world, frame, -2, 0, 0, 0.64);
	ASSERT(frame.Pixel(16, 10) # 0202938H);
	ASSERT(frame.Pixel(16, 10) # 035302CH);
	GameRenderer.Render(world, frame, 2, 0, 0, 0.89);
	ASSERT(frame.Pixel(16, 19) MOD 256 = 0);
	ASSERT(frame.Pixel(16, 19) DIV 65536 = 0);
	ASSERT(frame.Pixel(16, 19) DIV 256 > 0)
END Do;

END SectorSmoke.
